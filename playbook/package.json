{
  "name": "flavor-playbook",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-dashes.mjs $(test -d ../playbook && echo .. || echo .)",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
